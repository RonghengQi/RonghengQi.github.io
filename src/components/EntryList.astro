---
import { Image } from "astro:assets";

// Shared by Education, Research Experience, Projects, Awards and Teaching:
// optional logo on the left, name and role in the middle, dates aligned in a
// column on the right. One component for all of them keeps the rhythm of the
// page identical from section to section.
//
// Every field except `org` is optional:
//   org    institution, project or course name (bold)
//   desc   one or two sentences on what it is
//   role   your role, advisor, or anything secondary
//   date   right-hand column; keep the format consistent across sections
//   logo   imported image, shown at 48px
//   url    makes `org` a link
//   links  buttons appended to the role line
const { items } = Astro.props;
const withLogo = items.some((e) => e.logo);
---

<div class:list={["entries", withLogo && "has-logo"]}>
  {
    items.map((e) => (
      <div class="entry">
        {withLogo && (
          <span class="entry-logo">
            {e.logo && (
              <Image
                src={e.logo}
                alt=""
                widths={[48, 96, 144]}
                sizes="48px"
                loading="lazy"
              />
            )}
          </span>
        )}
        <div>
          <p class="entry-org">
            <strong>
              {e.url ? (
                <a href={e.url} target="_blank" rel="noopener noreferrer">
                  {e.org}
                </a>
              ) : (
                e.org
              )}
            </strong>
          </p>
          {/* Description first, advisor second: say what the thing is before
              saying who supervised it. */}
          {e.desc && <p class="entry-desc">{e.desc}</p>}
          {/* Links ride on the end of the role line, separated by "·", so a
              single button never sits alone on a line of its own. */}
          {(e.role || e.links?.length > 0) && (
            <p class="entry-role muted">
              {e.role}
              {e.links?.map((l, i) => (
                <span>
                  {(e.role || i > 0) && " · "}
                  <a href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label}
                  </a>
                </span>
              ))}
            </p>
          )}
        </div>
        <span class="entry-date muted-2">{e.date}</span>
      </div>
    ))
  }
</div>
