---
// The visible label is the language the visitor will switch to.
import languageIcon from "../assets/sidebar/language.png";
---

<button type="button" class="side-item language-toggle" data-language-toggle>
  <span
    class="side-icon"
    aria-hidden="true"
    style={`--side-icon: url("${languageIcon.src}")`}></span>
  <span class="when-english">中文</span>
  <span class="when-chinese">English</span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector("[data-language-toggle]");

  button?.addEventListener("click", () => {
    const next = root.dataset.lang === "zh" ? "en" : "zh";
    root.dataset.lang = next;
    root.lang = next === "zh" ? "zh-CN" : "en";
    try {
      localStorage.setItem("language", next);
    } catch {
      /* private mode: the choice just does not persist */
    }
  });
</script>
