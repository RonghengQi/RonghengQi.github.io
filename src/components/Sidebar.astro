---
import { Image } from "astro:assets";
import cvIcon from "../assets/sidebar/cv.png";
import educationIcon from "../assets/sidebar/education.png";
import emailIcon from "../assets/sidebar/email.png";
import githubIcon from "../assets/sidebar/github.png";
import linkedinIcon from "../assets/sidebar/linkedin.png";
import locationIcon from "../assets/sidebar/location.png";
import { profile } from "../data.js";
import { zh } from "../i18n.js";
import { site } from "../site.config.js";
import LanguageToggle from "./LanguageToggle.astro";
import LocalizedText from "./LocalizedText.astro";
import ThemeToggle from "./ThemeToggle.astro";

const linkIcons = [emailIcon, linkedinIcon, githubIcon, cvIcon];
const iconStyle = (icon) => `--side-icon: url("${icon.src}")`;
---

<aside>
  <div class="avatar-wrap">
    <Image
      class="avatar"
      src={profile.photo}
      alt={`Portrait of ${profile.nameEn}`}
      widths={[200, 400, 600]}
      sizes="(max-width: 760px) 150px, 200px"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="side-details">
    <h2 class="side-name">
      <LocalizedText en={profile.nameEn} zh={profile.nameCn} />
    </h2>
    <p class="side-role muted">
      <LocalizedText en={profile.role[0]} zh={zh.profile.role[0]} />
    </p>
    <div class="side-links">
      <span class="side-item muted">
        <span
          class="side-icon"
          aria-hidden="true"
          style={iconStyle(educationIcon)}
        />
        <span>
          <LocalizedText en={profile.role[1]} zh={zh.profile.role[1]} />
        </span>
      </span>
      {
        profile.location && (
          <span class="side-item muted">
            <span
              class="side-icon"
              aria-hidden="true"
              style={iconStyle(locationIcon)}
            />
            <span>
              <LocalizedText en={profile.location} zh={zh.profile.location} />
            </span>
          </span>
        )
      }
      {
        profile.links.map((l, i) =>
          l.hrefZh ? (
            <>
              <a
                class="side-item"
                lang="en"
                data-lang-content="en"
                href={l.href}
                target={l.newTab ? "_blank" : undefined}
                rel={l.newTab ? "noopener noreferrer" : undefined}
              >
                <span
                  class="side-icon"
                  aria-hidden="true"
                  style={iconStyle(linkIcons[i])}
                />
                <span>{l.label}</span>
              </a>
              <a
                class="side-item"
                lang="zh-CN"
                data-lang-content="zh"
                href={l.hrefZh}
                target={l.newTab ? "_blank" : undefined}
                rel={l.newTab ? "noopener noreferrer" : undefined}
              >
                <span
                  class="side-icon"
                  aria-hidden="true"
                  style={iconStyle(linkIcons[i])}
                />
                <span>{zh.profile.links[i]}</span>
              </a>
            </>
          ) : (
            <a
              class="side-item"
              href={l.href}
              target={l.newTab ? "_blank" : undefined}
              rel={l.newTab ? "noopener noreferrer" : undefined}
            >
              <span
                class="side-icon"
                aria-hidden="true"
                style={iconStyle(linkIcons[i])}
              />
              <span>
                <LocalizedText en={l.label} zh={zh.profile.links[i]} />
              </span>
            </a>
          ),
        )
      }
      <LanguageToggle />
      {site.theme.toggle && <ThemeToggle />}
    </div>
  </div>
</aside>

<script>
  // If the photo fails to load, drop its src so the "Photo" placeholder
  // underneath shows through instead of a broken-image icon.
  document.querySelectorAll("img.avatar").forEach((img) => {
    const drop = () => img.removeAttribute("src");
    img.addEventListener("error", drop);
    // This script is deferred, so the image may already have failed before it
    // runs and the error event is long gone. Check for that case directly:
    // finished loading but zero pixels wide means it failed.
    if (img.complete && img.naturalWidth === 0) drop();
  });
</script>
