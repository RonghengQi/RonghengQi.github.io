---
// Light/dark switch. The theme itself is applied before first paint by the
// inline script in Base.astro; this only records a choice and flips the
// attribute. Both labels are in the HTML and CSS shows the relevant one, so
// the button reads correctly even before this script runs.
import { zh } from "../i18n.js";
import themeIcon from "../assets/sidebar/theme.png";
import LocalizedText from "./LocalizedText.astro";
---

{/* No aria-label: the visible text is the accessible name. An aria-label of
    "Switch to dark theme" over a button reading "Dark mode" fails WCAG 2.5.3
    (Label in Name) — someone using voice control says what they can see, and
    "click Dark mode" would not match. */}
<button type="button" class="side-item theme-toggle" data-theme-toggle>
  <span
    class="side-icon"
    aria-hidden="true"
    style={`--side-icon: url("${themeIcon.src}")`}></span>
  <span class="when-light">
    <LocalizedText en="Dark mode" zh={zh.ui.darkMode} />
  </span>
  <span class="when-dark">
    <LocalizedText en="Light mode" zh={zh.ui.lightMode} />
  </span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector("[data-theme-toggle]");
  const media = matchMedia("(prefers-color-scheme: dark)");

  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* private mode: the choice just does not persist */
    }
  });

  // Until a choice is made, keep following the operating system live.
  media.addEventListener("change", (e) => {
    let saved = null;
    try {
      saved = localStorage.getItem("theme");
    } catch {
      /* ignore */
    }
    if (!saved) root.dataset.theme = e.matches ? "dark" : "light";
  });
</script>
