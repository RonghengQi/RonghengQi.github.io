---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import EntryList from "../components/EntryList.astro";
import PubItem from "../components/PubItem.astro";
import DemoNotice from "../components/DemoNotice.astro";
import LocalizedText from "../components/LocalizedText.astro";
import { site, absoluteUrl } from "../site.config.js";
import { zh } from "../i18n.js";
import {
  profile,
  about,
  education,
  publications,
  workingPapers,
  patents,
  experience,
  workExperience,
  projects,
  awards,
  teaching,
  skills,
  lastUpdated,
} from "../data.js";

const title = [profile.nameEn, profile.nameCn].filter(Boolean).join(" ");

// Structured data, assembled from the same content the page renders — nothing
// to keep in sync by hand. Institutions you list an `url` for in `education`
// become `alumniOf`; external profile links become `sameAs`.
const email = profile.links.find((l) => l.href.startsWith("mailto:"))?.href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.nameEn,
  ...(profile.nameCn && { alternateName: profile.nameCn }),
  url: absoluteUrl("/"),
  jobTitle: site.seo.jobTitle,
  description: site.description,
  ...(email && { email }),
  ...(site.seo.affiliation && {
    affiliation: { "@type": "CollegeOrUniversity", ...site.seo.affiliation },
  }),
  alumniOf: education
    .filter((e) => e.url && e.org !== site.seo.affiliation?.name)
    .map((e) => ({
      "@type": "CollegeOrUniversity",
      name: e.org,
      sameAs: e.url,
    })),
  ...(site.seo.location && {
    homeLocation: {
      "@type": "Place",
      address: {
        "@type": "PostalAddress",
        addressLocality: site.seo.location.locality,
        addressCountry: site.seo.location.country,
      },
    },
  }),
  knowsAbout: site.seo.knowsAbout,
  sameAs: profile.links
    .filter((l) => /^https?:/.test(l.href))
    .map((l) => l.href),
};
---

<Base title={title} path="/" jsonLd={jsonLd}>
  {site.demoNotice && <DemoNotice repo={site.repo} />}

  {/* Full-bleed masthead: the rule spans the viewport while the name inside
      lines up with the content below. */}
  <header class="site-header">
    <h1>
      <span lang="en" data-lang-content="en">
        {profile.nameEn}
        {profile.nameCn && <span class="cn">{profile.nameCn}</span>}
      </span>
      <span class="name-zh" lang="zh-CN" data-lang-content="zh">
        {profile.nameCn}
        <span class="name-en-secondary" lang="en">{profile.nameEn}</span>
      </span>
    </h1>
  </header>

  <div class="page">
    <Sidebar />

    {/* Every section below disappears on its own when its array in
        src/data.js is empty. To reorder the page, move these blocks. */}
    <main>
      {
        about.length > 0 && (
          <Section id="about" title="About Me" titleZh={zh.sections.about}>
            <div class="prose">
              {about.map((para, i) => (
                <p>
                  <LocalizedText en={para} zh={zh.about[i]} html={true} />
                </p>
              ))}
            </div>
          </Section>
        )
      }

      {
        education.length > 0 && (
          <Section
            id="education"
            title="Education"
            titleZh={zh.sections.education}
          >
            <EntryList items={education} translations={zh.education} />
          </Section>
        )
      }

      {
        publications.length > 0 && (
          <Section
            id="publications"
            title="Manuscripts"
            titleZh={zh.sections.manuscripts}
          >
            <div class="pubs">
              {publications.map((p, i) => (
                <PubItem {...p} translation={zh.manuscripts[i]} />
              ))}
            </div>
          </Section>
        )
      }

      {
        patents.length > 0 && (
          <Section id="patents" title="Patents" titleZh={zh.sections.patents}>
            <EntryList items={patents} translations={zh.patents} />
          </Section>
        )
      }

      {
        workingPapers.length > 0 && (
          <Section
            id="working-papers"
            title="Working Papers"
            titleZh={zh.sections.workingPapers}
          >
            <div class="pubs">
              {workingPapers.map((p, i) => (
                <PubItem {...p} translation={zh.workingPapers?.[i]} />
              ))}
            </div>
          </Section>
        )
      }

      {
        experience.length > 0 && (
          <Section
            id="experience"
            title="Research Experience"
            titleZh={zh.sections.experience}
          >
            <EntryList items={experience} translations={zh.experience} />
          </Section>
        )
      }

      {
        workExperience.length > 0 && (
          <Section
            id="work-experience"
            title="Work Experience"
            titleZh={zh.sections.workExperience}
          >
            <EntryList
              items={workExperience}
              translations={zh.workExperience}
            />
          </Section>
        )
      }

      {
        projects.length > 0 && (
          <Section id="projects" title="Projects" titleZh={zh.sections.projects}>
            <EntryList items={projects} translations={zh.projects} />
          </Section>
        )
      }

      {
        awards.length > 0 && (
          <Section
            id="awards"
            title="Awards"
            titleZh={zh.sections.awards}
          >
            <EntryList items={awards} translations={zh.awards} />
          </Section>
        )
      }

      {
        teaching.length > 0 && (
          <Section id="teaching" title="Teaching" titleZh={zh.sections.teaching}>
            <EntryList items={teaching} translations={zh.teaching} />
          </Section>
        )
      }

      {
        skills.length > 0 && (
          <Section id="skills" title="Skills" titleZh={zh.sections.skills}>
            <EntryList items={skills} translations={zh.skills} />
          </Section>
        )
      }

      <footer>
        <LocalizedText
          en={`Last updated ${lastUpdated}`}
          zh={zh.ui.lastUpdated}
        />
      </footer>
    </main>
  </div>
</Base>
